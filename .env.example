# Copy to .env and fill in. .env is gitignored.
#
# FIRST-TIME DATABASE SETUP: run `pnpm db:setup`, not `pnpm db:push`.
# `db push` creates the tables but leaves them readable over Supabase's REST
# API with the anon key - which ships in the browser bundle. db:setup pushes
# the schema AND applies prisma/rls.sql, which closes that. Verified: all
# tables returned 200 with customer data before rls.sql ran, 401 after.

# ---------------------------------------------------------------- database
# Supabase > Connect. Two strings, NOT interchangeable.
#
# DATABASE_URL  runtime queries. Use the TRANSACTION POOLER (port 6543) in
#               production: db.<ref>.supabase.co is IPv6-only and Vercel
#               functions have no IPv6 egress, so a direct URL fails there
#               while working fine from a laptop. Add ?pgbouncer=true when
#               pointing at the pooler.
# DIRECT_URL    migrations only. pgbouncer multiplexes sessions and cannot
#               run DDL, so this must be a direct (or session-pooler) URL.
#
# Percent-encode the password. A literal "#" starts a URL fragment and silently
# truncates everything after it, so the password reads as empty and you get an
# auth error rather than a parse error.
DATABASE_URL=""
DIRECT_URL=""

# ---------------------------------------------------------------- supabase
# Supabase > Project Settings > API. The publishable key is public by design;
# RLS protects the data, not this string.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------- model
# Set at least one. Precedence: groq > google > openrouter.
#
# THE MODEL MUST SUPPORT TOOL CALLING. The agent never emits free text as an
# action - it calls propose_action and the policy engine rules on it. A model
# without tool calling returns confident prose and does nothing, and the
# failure reads as "the agent chose not to act" rather than as a bug.
# Verify with `pnpm check:model`; list what a key can reach with
# `pnpm check:model --list`.
GROQ_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
OPENROUTER_API_KEY=""

# ---------------------------------------------------------------- optional
# WARDEN_PROVIDER   force one of: groq | google | openrouter
# WARDEN_MODEL      override the per-provider default model id
# WARDEN_INGEST_SECRET  when set, /api/leads/ingest requires it in the
#                       x-warden-secret header. Leave unset for demos.
# WARDEN_PUBLIC_URL     deployed origin, sent as OpenRouter attribution only.
